# 复制为项目根目录 .env.local。填写一个智谱密钥即可同时启用回答与向量检索。
ZHIPU_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
# 可选：指定供应商支持的向量维度；更改后需完整重建，不能混用旧向量。
EMBEDDING_DIMENSIONS=0
# 使用其他供应商时，分别设置对应密钥；智谱密钥只会用于官方域名。
LLM_API_KEY=
EMBEDDING_API_KEY=
# 不设置 DATABASE_URL 时，默认使用 data/knowledge.db
DATA_DIR=./data

# 可选：额外回答模型。密钥只引用环境变量名，不写进 JSON；重启后端后在页面选择。
# LLM_PROFILES=[{"id":"secondary","label":"备用模型","base_url":"https://your-provider.example/v1","model":"your-model","api_key_env":"SECONDARY_API_KEY"},{"id":"local","label":"本地模型","base_url":"http://127.0.0.1:11434/v1","model":"your-local-model"}]
# SECONDARY_API_KEY=
# Tesseract OCR 语言；macOS 也支持本地 Apple Vision，Docker 已包含 Tesseract 中英文包。
OCR_LANGUAGES=chi_sim+eng
